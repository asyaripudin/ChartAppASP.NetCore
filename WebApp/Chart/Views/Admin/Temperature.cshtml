@{
    ViewData["Title"] = "Data Visualization";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<h1>@ViewData["Title"]</h1>
<!DOCTYPE html>
<html>
<head>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js" integrity="sha256-bqVeqGdJ7h/lYPq6xrPv/YGzMEb6dNxlfiTUHSgRCp8=" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/css/bootstrap-datepicker.min.css" integrity="sha256-siyOpF/pBWUPgIcQi17TLBkjvNgNQArcmwJB8YvkAgg=" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/datatables.min.js"></script>
    <script src="~/js/temperature.js"></script>
    <link href="~/css/datatables.min.css" rel="stylesheet" />
    <link href="~/css/mdb.min.css" rel="stylesheet" />
    <script src="~/sweetalert/dist/sweetalert-dev.js"></script>
    <script src="~/sweetalert/dist/sweetalert.min.js"></script>
    <link href="~/sweetalert/dist/sweetalert.css" rel="stylesheet" />
    <script>
        window.onload = function () {
        }
        $(function ($) {
            $(".datepicker").datepicker({
                format: 'dd/mm/yyyy',
                autoclose: true,
                todayHighlight: true
            });
        });

        $(function ($) {

            $(".txtTanggal").datepicker({
                onSelect: function (dateText) {
                    $(this).change();
                }
            }).on("change", function () {
                var tanggal = $(".txtTanggal").val();

                display(tanggal);
            });

            function display(msg) {
                $("#ViewTable").on('click', function () {

                    $.noConflict();

                    $("#tbl_temp").css({ display: 'block' });
                    $("#ViewTable").prop('disabled', true);

                    $("#chart_temp").css({ display: 'none' });
                })

                $("#ViewChart").on('click', function () {

                    $("#chart_temp").css({ display: 'block' });
                    $("#ViewChart").prop('disabled', true);
                    $("#tbl_temp").css({ display: 'none' });
                })
            }
        });
    </script>
</head>
<body id="body">
    <div class="main-content">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <form method="post" enctype="multipart/form-data" asp-controller="Temperature" asp-action="ImportFile">
                        <table class="table-responsive" width="100%">
                            <tr>
                                <td width="40%"> <label for="importFile" style="font-size:14px; font-weight:bold;">Import Data Temperature</label></td>
                                <td width="60%" style="padding:5px 0; float:left; position:absolute; margin:0 -248px;">
                                    <input type="file" class="form-control importFile" name="importFile" id="importFile" style="width:120px;" />
                                    <button id="btnImport" onclick="ImportFile($('#importFile').val());" class="btn btn-primary" style="position:absolute; margin:-33px 125px; color:#ffffff; font-weight:bold; padding: 2px 15px; height:35px;">
                                        <i class="fa fa-upload"></i><span style="margin:0 10px; color:#ffffff;">Import</span>
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td width="40%"> <label for="txtTanggal" style="padding:20px 0; font-size:14px; font-weight:bold;">Date</label></td>
                                <td width="60%" style="padding:20px 0; float:left; position:absolute; margin:0 -248px;">
                                    <input type="text" class="form-control datepicker txtTanggal" id="txtTanggal" style="width:220px;" />
                                </td>
                            </tr>
                        </table>
                    </form>
                    <div style="position:relative; top:-20px;">
                        <button type="button" id="ViewTable" onchange="" onclick="getTemperature();"
                                class="btn btn-primary" style="margin:17px 0; color:#ffffff;
                                padding: 2px 4px;">
                            <i class="fa fa-table" style="margin:0 10px;"></i><span style="margin:20px 12px;
                                font-size:14px; font-weight:bold;color:#ffffff;">
                                View Table
                            </span>
                        </button>&nbsp;&nbsp;
                        <button type="button" id="ViewChart" onchange="" onclick="getGraphic();"
                                class="btn btn-primary" style="margin:17px 0; color:#ffffff;
                                padding: 2px 4px;">
                            <i class="fa fa-bar-chart" style="margin:0 10px;"></i><span style="margin:20px 12px;
                                font-size:14px; font-weight:bold;color:#ffffff;">
                                View Chart
                            </span>
                        </button>&nbsp;&nbsp;
                        <button type="button" id="Refresh" onchange="" onclick="refreshTable();"
                                class="btn btn-primary" style="margin:17px 0; color:#ffffff;
                                padding: 2px 4px;">
                            <i class="fa fa-refresh" style="margin:0 10px;"></i><span style="margin:20px 12px;
                                font-size:14px; font-weight:bold;color:#ffffff;">
                                Refresh
                            </span>
                        </button>
                    </div>
                    <div id="tbl_temp" style="display:none;">
                        <h4 style="text-align:center; text-decoration: underline;">Temperature List </h4>
                        <table id="tableTemperature" class="table table-bordered table-striped table-hover display"
                               width="100%">
                            <thead>
                                <tr>
                                    <th style="text-align:center; font-size:14px;" width="20">
                                        NO
                                    </th>
                                    <th style="text-align:center; font-size:14px;" width="20">
                                        TIME
                                    </th>
                                    <th style="text-align:center; font-size:14px;" width="20">
                                        RADIATION
                                    </th>
                                    <th style="text-align:center; font-size:14px;" width="180">
                                        TEMPERATURE
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="tbody"></tbody>
                        </table>
                    </div>
                    <br /><br />
                    <div id="chart_temp" style="display:none;">
                        <h3>Chart</h3>
                        <canvas id="lineChartRadiation" width="200" height="110" style="width:197px; height:110px;"></canvas>
                        <br />
                        <canvas id="lineChartTemperature" width="200" height="110" style="width:197px; height:110px;"></canvas>
                    </div>
                </div>
            </div>

        </div>
    </div>
</body>
</html>